#!/usr/bin/env bash
# Install or remove Hyprland binds for dennislexis.zoom-in-out.
# Omarchy plugins cannot run installer hooks; the service calls this on load.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ZOOM="${PLUGIN_DIR}/bin/omarchy-zoom"

mode="${1:-install}"

if ! command -v hyprctl >/dev/null 2>&1; then
  echo "omarchy-zoom-binds: hyprctl not found" >&2
  exit 1
fi

# XKB keycodes (evdev): 20 = minus, 21 = equal, 19 = 0. Same mapping Omarchy
# uses for window resize, so these work on non-US layouts the same way.
unbind_zoom_keys() {
  hyprctl -q --batch "\
keyword unbind SUPER, code:20 ; \
keyword unbind SUPER, code:21 ; \
keyword unbind SUPER SHIFT, code:20 ; \
keyword unbind SUPER SHIFT, code:21 ; \
keyword unbind SUPER, minus ; \
keyword unbind SUPER, equal ; \
keyword unbind SUPER SHIFT, equal ; \
keyword unbind SUPER SHIFT, plus ; \
keyword unbind SUPER, plus ; \
keyword unbind SUPER CTRL, code:19"
}

restore_omarchy_resize() {
  # Stock Omarchy quattro tiling.lua window-resize binds.
  hyprctl -q --batch "\
keyword unbind SUPER, code:20 ; \
keyword unbind SUPER, code:21 ; \
keyword unbind SUPER SHIFT, code:20 ; \
keyword unbind SUPER SHIFT, code:21 ; \
keyword bindd SUPER, code:20, Expand window left, resizeactive, -100 0 ; \
keyword bindd SUPER, code:21, Shrink window left, resizeactive, 100 0 ; \
keyword bindd SUPER SHIFT, code:20, Shrink window up, resizeactive, 0 -100 ; \
keyword bindd SUPER SHIFT, code:21, Expand window down, resizeactive, 0 100"
}

install_zoom_binds() {
  unbind_zoom_keys
  hyprctl -q --batch "\
keyword bindd SUPER, code:21, Zoom in, exec, ${ZOOM} in ; \
keyword bindd SUPER SHIFT, code:21, Zoom in, exec, ${ZOOM} in ; \
keyword bindd SUPER, equal, Zoom in, exec, ${ZOOM} in ; \
keyword bindd SUPER SHIFT, equal, Zoom in, exec, ${ZOOM} in ; \
keyword bindd SUPER, plus, Zoom in, exec, ${ZOOM} in ; \
keyword bindd SUPER SHIFT, plus, Zoom in, exec, ${ZOOM} in ; \
keyword bindd SUPER, code:20, Zoom out, exec, ${ZOOM} out ; \
keyword bindd SUPER SHIFT, code:20, Zoom out, exec, ${ZOOM} out ; \
keyword bindd SUPER, minus, Zoom out, exec, ${ZOOM} out ; \
keyword bindd SUPER SHIFT, minus, Zoom out, exec, ${ZOOM} out ; \
keyword bindd SUPER CTRL, code:19, Reset zoom, exec, ${ZOOM} reset"
}

case "$mode" in
  install)
    install_zoom_binds
    ;;
  remove)
    unbind_zoom_keys
    restore_omarchy_resize
    ;;
  *)
    echo "Usage: omarchy-zoom-binds <install|remove>" >&2
    exit 2
    ;;
esac
