#!/usr/bin/env bash
# Zoom the focused window's text (browser page zoom / terminal font), not a
# screen magnifier. Intended for Omarchy (Arch + Hyprland).
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omarchy-zoom <in|out|reset>

Sends the focused app's native zoom shortcut via Hyprland sendshortcut.
EOF
}

action="${1:-}"
case "$action" in
  in | out | reset) ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if ! command -v hyprctl >/dev/null 2>&1; then
  echo "omarchy-zoom: hyprctl not found (Hyprland session required)" >&2
  exit 1
fi

class="$(hyprctl activewindow 2>/dev/null | awk -F': ' '/^[[:space:]]*class:/{print tolower($2); exit}')"

# Hyprland sendshortcut: MODS, KEY [, window]
# Empty window selector targets the focused client.
send() {
  local mods="$1"
  local key="$2"
  hyprctl -q dispatch sendshortcut "${mods}, ${key},"
}

# Kitty / WezTerm default to Ctrl+Shift for font size so Ctrl+C/V stay intact.
is_ctrl_shift_terminal() {
  case "$class" in
    kitty | kitty-dropterm | org.wezfurlong.wezterm | wezterm | wezterm-gui)
      return 0
      ;;
  esac
  return 1
}

zoom_in() {
  if is_ctrl_shift_terminal; then
    send "CTRL SHIFT" "equal"
    return
  fi
  # Browsers, Ghostty, Alacritty, foot, gnome-terminal, VS Code, and many
  # GTK/Qt apps: Ctrl+= (same physical key as Ctrl++ on US layouts).
  send "CTRL" "equal"
}

zoom_out() {
  if is_ctrl_shift_terminal; then
    send "CTRL SHIFT" "minus"
    return
  fi
  send "CTRL" "minus"
}

zoom_reset() {
  if is_ctrl_shift_terminal; then
    case "$class" in
      kitty | kitty-dropterm)
        send "CTRL SHIFT" "BackSpace"
        ;;
      *)
        send "CTRL SHIFT" "0"
        ;;
    esac
    return
  fi
  send "CTRL" "0"
}

case "$action" in
  in) zoom_in ;;
  out) zoom_out ;;
  reset) zoom_reset ;;
esac
